{
    "version": 2,
    "outputDirectory": "build/web-desktop",
    "rewrites": [
      {
        "source": "/((?!assets|src|cocos-js|favicon.ico|style.css|application.js|index.js).*)",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "/(.*\\.wasm)",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/wasm"
          }
        ]
      },
      {
        "source": "/(.*\\.bin)",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/octet-stream"
          }
        ]
      },
      {
        "source": "/(.*\\.json)",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ]
      },
      {
        "source": "/(.*\\.js)",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/javascript"
          }
        ]
      }
    ]
  }
  